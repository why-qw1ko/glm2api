# =============================================================================
# GLMWEB2API 配置示例。复制为 .env 后按需修改。
# 所有项都有默认值，不写也能启动（登录后可调用，监听 127.0.0.1:8788）。
# =============================================================================

# ---- 监听 ----
# 只给本机用填 127.0.0.1；局域网访问填 0.0.0.0（注意：0.0.0.0 会暴露到局域网）
HOST=127.0.0.1
PORT=8788

# ---- 上游 ----
# 上游基址，一般不用改
GLM_BASE_URL=https://chatglm.cn/chatglm
# 签名密钥。上游轮换时通过它覆盖（一般不用动）
# GLM_SIGN_SECRET=8a1317a7468aa3ad86e997d08f3f31cb

# ---- agent 模式（可选，走 agentmore.chatglm.cn 的 Agent 后端，内置工具 + 联网）----
# 开启后默认走 agent 后端；面板“聊天”页可在“对话 / Agent”双模式间切换，此值作为默认模式
GLM_AGENT_MODE=false
# GLM_AGENT_BASE_URL=https://agentmore.chatglm.cn/chatglm
# GLM_AGENT_ORIGIN=https://agentmore.chatglm.cn

# ---- 凭据（可先留空，启动后在 /panel/ 接入官方账号）----
# 单个账号：浏览器登录 chatglm.cn 后，F12 → Application → Cookies → chatglm_refresh_token（兼容旧版 Local Storage）
GLM_REFRESH_TOKEN=

# 多账号：每行一个 refresh_token 的文件路径（可手动维护，或由 /admin/refresh-token 写入）
GLM_TOKEN_FILE=data/refresh_tokens.json

# ---- 并发 ----
# 同时占用上游的请求数。上游对并发敏感，超限会限流，保守默认 3
GLM_MAX_CONCURRENCY=3
# 请求结束后是否删除上游会话（避免服务端堆积），默认开启
GLM_DELETE_CONVERSATION=true

# ---- 本服务访问控制 ----
# 若填写（JSON 数组），调用本服务的客户端必须携带其中一个密钥
# SERVER_API_KEYS=["your-secret-key"]

# ---- 网络 ----
# 发往上游时使用代理（可选）
# PROXY=http://127.0.0.1:7897

# ---- 模型 ----
# 对话与生图用的 assistant_id（一般不用改）
# CHAT_ASSISTANT_ID=65940acff94777010aa6b796
# IMAGE_ASSISTANT_ID=65a232c082ff90a2ad2f15e2

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- 管理面板：/panel/ ----
# 可选：至少 12 字符。未设置时，首次启动生成 data/panel-bootstrap.txt。
# PANEL_PASSWORD=
PANEL_DATA_DIR=data
# 桌面命令行启动时自动打开面板；Docker 固定关闭。
PANEL_OPEN_BROWSER=true
# HTTPS 反代部署建议开启；纯 HTTP 本机调试保持 false。
PANEL_COOKIE_SECURE=false
# Windows 自动优先使用已安装的 Edge / Chrome；Docker 使用随镜像安装的 Chromium。
# PANEL_BROWSER_CHANNEL=msedge
# 统计和操作日志的保留天数，可在面板中修改。
# PANEL_RETENTION_DAYS=90
# Compose 默认含浏览器；仅手动导入时可设置 INSTALL_BROWSER=false 缩小镜像。
# INSTALL_BROWSER=true
# 默认仅绑定宿主机回环地址，公网请经 HTTPS 反代访问。
# BIND_ADDRESS=127.0.0.1
